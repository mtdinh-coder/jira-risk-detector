# ============= Jira =============
# Atlassian site URL, e.g. https://nvidia.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net
# Email of the account whose API token you generated
JIRA_EMAIL=you@nvidia.com
# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Project key, e.g. ABC (the prefix in ABC-123 ticket IDs)
JIRA_PROJECT_KEY=ABC
# Optional extra JQL appended with AND, e.g. "fixVersion = '2026.Q2'"
JIRA_EXTRA_JQL=

# ============= Risk thresholds =============
# In Progress tickets with no update for >= this many days are flagged as stalled
STALLED_DAYS=3
# Tickets due within this many days with status != Done are flagged as approaching due
DUE_SOON_DAYS=2
# How many recent comments to feed into the AI summarizer (most-recent-first)
COMMENTS_FOR_SUMMARY=8

# ============= Anthropic (Claude) =============
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============= Slack =============
# Bot User OAuth Token, starts with xoxb-
# Required scopes: chat:write, im:write, users:read, users:read.email
SLACK_BOT_TOKEN=
# Channel ID (not name) for the public Dev/QA tagging post, e.g. C0123456789
SLACK_TEAM_CHANNEL_ID=
# TPM's email — used to look up the Slack user ID for the DM. Defaults to JIRA_EMAIL if blank.
SLACK_TPM_EMAIL=

# ============= Behavior =============
# Set to true to print the message to console instead of sending to Slack
DRY_RUN=false
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
